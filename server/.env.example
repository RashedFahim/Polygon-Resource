# Gmail SMTP settings. Use a Google app password, not your Gmail password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional sender address. It should normally match SMTP_USER.
SMTP_FROM=

# Contact inquiries are delivered here. It defaults to SMTP_USER when blank.
CONTACT_RECIPIENT_EMAIL=

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=
