# Gmail SMTP settings. Use a Google app password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=polygon.resource@gmail.com
SMTP_PASS=

# Optional sender address. It should normally match SMTP_USER.
# SMTP_FROM=polygon.resource@gmail.com

# Contact inquiries are delivered here by default.
CONTACT_RECIPIENT_EMAIL=polygon.resource@gmail.com

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
